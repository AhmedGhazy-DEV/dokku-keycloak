#!/usr/bin/env bash
# Constants shared by every command. Values marked overridable can be set in
# a file under /home/dokku/.dokkurc/, which Dokku sources before each command.

export KEYCLOAK_PLUGIN_NAME="keycloak"

# Oldest Dokku the full test suite passes on. 0.35 fails the first deploy:
# it does not retry a healthcheck that answers 503 while Keycloak starts.
export KEYCLOAK_MIN_DOKKU_VERSION="0.36.0"

# Keycloak release used for new instances; bumped only after it passes the
# full lifecycle test suite.
export KEYCLOAK_DEFAULT_VERSION="26.8.1"

# overridable: mirror of quay.io/keycloak/keycloak for air-gapped hosts
export KEYCLOAK_IMAGE_REPO="${KEYCLOAK_IMAGE_REPO:-quay.io/keycloak/keycloak}"

# Memory limit applied to new instances. Keycloak sizes its heap from the
# container limit (70% by default), so this is the main tuning knob.
export KEYCLOAK_DEFAULT_MEMORY="2048m"

export KEYCLOAK_ADMIN_USER="admin"

# Keycloak options that only take effect through `kc.sh build` (from
# `kc.sh build --help-all`). Setting one of these as config triggers an image
# rebuild; everything else is a plain runtime variable.
export KEYCLOAK_BUILD_OPTIONS="KC_DB KC_DB_DRIVER KC_DB_DRIVER_* KC_DB_HEALTH_EXCLUDE_* KC_DB_KIND_*
KC_TRANSACTION_XA_ENABLED KC_TRANSACTION_XA_ENABLED_* KC_FEATURE_* KC_FEATURES KC_FEATURES_DISABLED
KC_HTTP_RELATIVE_PATH KC_HTTPS_CLIENT_AUTH KC_HEALTH_ENABLED KC_HTTP_MANAGEMENT_HEALTH_ENABLED
KC_HTTP_MANAGEMENT_RELATIVE_PATH KC_HTTPS_MANAGEMENT_CLIENT_AUTH KC_LEGACY_OBSERVABILITY_INTERFACE
KC_METRICS_ENABLED KC_VAULT KC_LOG_MDC_ENABLED KC_TELEMETRY_LOGS_ENABLED KC_TELEMETRY_METRICS_ENABLED
KC_TRACING_ENABLED KC_TRACING_JDBC_ENABLED KC_TRACING_SAMPLER_TYPE KC_EVENT_METRICS_USER_ENABLED
KC_FIPS_MODE KC_OPENAPI_ENABLED KC_OPENAPI_UI_ENABLED"

# Plugin-owned files (pre-upgrade database backups).
export KEYCLOAK_DATA_ROOT="${DOKKU_LIB_ROOT:-/var/lib/dokku}/data/keycloak"
