#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-keycloak-stop() {
  declare desc="stops a Keycloak instance"
  declare cmd="keycloak:stop"
  [[ "$1" == "$cmd" ]] && shift 1
  declare APP="$1"

  verify_keycloak_name "$APP"
  dokku ps:stop "$APP"
}

cmd-keycloak-stop "$@"
