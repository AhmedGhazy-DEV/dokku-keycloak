#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-keycloak-admin-credentials() {
  declare desc="prints the bootstrap admin credentials of a Keycloak instance"
  declare cmd="keycloak:admin-credentials"
  [[ "$1" == "$cmd" ]] && shift 1
  declare APP="$1"

  verify_keycloak_name "$APP"
  echo "Username: $KEYCLOAK_ADMIN_USER"
  echo "Password: $(fn-keycloak-get "$APP" admin-password)"
  # stderr, so `| grep Password` and similar stay clean
  dokku_log_warn "Keycloak marks this bootstrap admin as temporary. Create a permanent admin in the master realm, then delete this one." >&2
  dokku_log_warn "If the password was changed in Keycloak, the value above is out of date." >&2
}

cmd-keycloak-admin-credentials "$@"
