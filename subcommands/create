#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-keycloak-create() {
  declare desc="creates a Keycloak instance backed by its own PostgreSQL database"
  declare cmd="keycloak:create"
  [[ "$1" == "$cmd" ]] && shift 1
  declare APP="" VERSION="" MEMORY=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        [[ -n "$2" ]] || dokku_log_fail "--version requires a value"
        VERSION="$2"
        shift 2
        ;;
      --memory)
        [[ -n "$2" ]] || dokku_log_fail "--memory requires a value"
        MEMORY="$2"
        shift 2
        ;;
      -*) dokku_log_fail "Unknown flag: $1" ;;
      *)
        [[ -z "$APP" ]] || dokku_log_fail "Unexpected argument: $1"
        APP="$1"
        shift
        ;;
    esac
  done

  [[ -n "$APP" ]] || dokku_log_fail "Please specify a name for the Keycloak instance"
  is_valid_app_name "$APP"
  fn-keycloak-require-plugin postgres

  # Flags win; a resumed create otherwise keeps what it was started with.
  VERSION="${VERSION:-$(fn-keycloak-get "$APP" version "$KEYCLOAK_DEFAULT_VERSION")}"
  MEMORY="${MEMORY:-$(fn-keycloak-get "$APP" memory "$KEYCLOAK_DEFAULT_MEMORY")}"
  fn-keycloak-validate-version "$VERSION"
  [[ "$MEMORY" =~ ^[0-9]+[bkmg]?$ ]] || dokku_log_fail "Invalid memory limit: $MEMORY (examples: 2048m, 2g)"

  # A finished instance is never touched again; a half-created one (for
  # example after a failed image download) is resumed from where it stopped.
  if fn-keycloak-exists "$APP"; then
    [[ "$(fn-keycloak-get "$APP" created)" != "true" ]] || dokku_log_fail "Keycloak instance $APP already exists"
    dokku_log_info1 "Resuming creation of Keycloak instance $APP"
  else
    if dokku apps:exists "$APP" >/dev/null 2>&1; then
      dokku_log_fail "App $APP already exists and is not a Keycloak instance"
    fi
    dokku_log_info1 "Creating Keycloak instance $APP"
    # dots are valid in app names but not in service names
    fn-keycloak-set "$APP" database "${APP//./-}-db"
    fn-keycloak-set "$APP" admin-password "$(od -An -tx1 -N24 /dev/urandom | tr -d ' \n')"
  fi
  fn-keycloak-set "$APP" version "$VERSION"
  fn-keycloak-set "$APP" memory "$MEMORY"

  local database network
  database="$(fn-keycloak-get "$APP" database)"
  network="$(fn-keycloak-get "$APP" network "keycloak-${APP//./-}")"

  # Keycloak reaches its database over a private network instead of a docker
  # link: links on the default bridge are deprecated. The app keeps the
  # default bridge as its first network, because Dokku's nginx and
  # healthchecks use that address and, on Docker-based Dokku installs, cannot
  # reach other networks.
  fn-keycloak-set "$APP" network "$network"
  dokku network:exists "$network" >/dev/null 2>&1 || dokku network:create "$network" >/dev/null
  dokku apps:exists "$APP" >/dev/null 2>&1 || dokku apps:create "$APP"
  dokku network:set "$APP" attach-post-create "$network" >/dev/null
  # Both commands print the database URL, password included, on stdout;
  # errors still reach the user on stderr.
  if ! dokku postgres:exists "$database" >/dev/null 2>&1; then
    dokku_log_info1 "Creating PostgreSQL service $database"
    dokku postgres:create "$database" --initial-network "$network" >/dev/null
  fi
  if ! dokku postgres:linked "$database" "$APP" >/dev/null 2>&1; then
    dokku_log_info1 "Linking $database to $APP"
    dokku postgres:link --no-restart "$database" "$APP" >/dev/null
  fi
  # postgres:link also adds a docker link, which would fail now that the
  # database is not on the default bridge. The service is reachable by the
  # same name on the private network. The link record (DATABASE_URL,
  # postgres:links, destroy protection) stays.
  local link_option="--link dokku.postgres.$database:dokku-postgres-$database"
  if dokku docker-options:report "$APP" | grep -qF -- "$link_option"; then
    dokku docker-options:remove "$APP" build,deploy,run "$link_option" >/dev/null
  fi

  dokku config:set --no-restart "$APP" \
    KC_PROXY_HEADERS=xforwarded \
    KC_HTTP_ENABLED=true \
    KC_HOSTNAME_STRICT=false >/dev/null

  # Only the HTTP listener is published; the management port (health and
  # metrics) stays reachable from the host and other containers only.
  dokku ports:set "$APP" http:80:8080
  # kc.sh forwards stop signals to Keycloak itself when it runs as PID 1,
  # which is what Keycloak expects; Dokku's injected init would be PID 1.
  dokku scheduler-docker-local:set "$APP" init-process false >/dev/null
  dokku resource:limit --memory "$(fn-keycloak-get "$APP" memory)" "$APP" >/dev/null

  fn-keycloak-apply "$APP"
  fn-keycloak-bootstrap-admin "$APP"
  fn-keycloak-set "$APP" created true

  dokku_log_info1 "Keycloak instance $APP is ready"
  dokku_log_verbose "Admin console: $(dokku url "$APP")/admin/"
  dokku_log_verbose "Credentials:   dokku keycloak:admin-credentials $APP"
}

fn-keycloak-bootstrap-admin() {
  declare desc="creates the temporary admin user once, without exposing its password"
  declare APP="$1"

  [[ "$(fn-keycloak-get "$APP" admin-created)" != "true" ]] || return 0
  dokku_log_info1 "Creating the bootstrap admin user"
  # The password reaches kc.sh on stdin, so it never appears in the app's
  # config, in any container's settings, or in output. Until this runs,
  # Keycloak only offers admin creation to requests from inside the container.
  # shellcheck disable=SC2016 # expanded by the container's shell
  fn-keycloak-get "$APP" admin-password | fn-keycloak-oneoff "$APP" '
    set -e
    IFS= read -r KC_BOOTSTRAP_ADMIN_PASSWORD
    export KC_BOOTSTRAP_ADMIN_PASSWORD
    /opt/keycloak/bin/kc.sh bootstrap-admin user --optimized --no-prompt \
      --username "$1" --password:env KC_BOOTSTRAP_ADMIN_PASSWORD >&2
  ' "$KEYCLOAK_ADMIN_USER" || dokku_log_fail "Creating the bootstrap admin user failed; re-run keycloak:create $APP"
  fn-keycloak-set "$APP" admin-created true
}

cmd-keycloak-create "$@"
