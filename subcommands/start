#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-keycloak-start() {
  declare desc="starts a Keycloak instance"
  declare cmd="keycloak:start"
  [[ "$1" == "$cmd" ]] && shift 1
  declare APP="$1"

  verify_keycloak_name "$APP"
  fn-keycloak-drop-db-link "$APP"
  dokku ps:start "$APP"
}

cmd-keycloak-start "$@"
